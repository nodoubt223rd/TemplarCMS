{
  "Logging": {
    "Console": {
      "FormatterName": "json",
      "Json": {
        "IncludeScopes": true,
        "TimestampFormat": "O"
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "TemplarCms": "Server=Salvatore;Database=templarcms_authoring;Integrated Security=True;Encrypt=True;TrustServerCertificate=True"
  },
  "Persistence": {
    "Provider": "SqlServer"
  },
  "Templates": {
    "TemplatesPath": "RuntimeData/Templates"
  },
  "AuthoringSecurity": {
    "Enabled": false,
    "ApiKeyHeaderName": "X-Templar-Api-Key",
    "ApiKey": ""
  },
  "OpenApi": {
    "Enabled": true
  },
  "UserDirectory": { "Enabled": false }
}
