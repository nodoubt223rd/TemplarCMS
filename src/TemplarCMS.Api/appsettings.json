{
  "Logging": {
    "Console": {
      "FormatterName": "json",
      "Json": {
        "IncludeScopes": true,
        "TimestampFormat": "O"
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "TemplarCms": "Data Source=RuntimeData/templarcms.db"
  },
  "Persistence": {
    "Provider": "Sqlite"
  },
  "Templates": {
    "TemplatesPath": "RuntimeData/Templates"
  },
  "AuthoringSecurity": {
    "Enabled": false,
    "ApiKeyHeaderName": "X-Templar-Api-Key",
    "ApiKey": ""
  },
  "OpenApi": {
    "Enabled": true
  }
}
